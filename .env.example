# ===== Model selection (HuggingFace Hub repo id or local path inside the cache) =====
MODEL_ID=Qwen/Qwen3-4B

# ===== HuggingFace =====
# Required for gated/private models. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
# Set to 1 to use hf_transfer for faster downloads (image must include it)
HF_HUB_ENABLE_HF_TRANSFER=1

# ===== Host paths =====
# Directory on the host where HuggingFace models will be cached/stored.
# Maps to /root/.cache/huggingface inside the container.
MODELS_DIR=./models

# ===== Networking =====
HOST_PORT=8000

# ===== vLLM runtime =====
IMAGE_TAG=latest
TP_SIZE=1
DTYPE=auto
# Fraction of GPU memory vLLM may use (KV cache + weights + activations)
GPU_MEMORY_UTILIZATION=0.88
# Max sequence length (prompt + generated tokens)
MAX_MODEL_LEN=8192

# ===== Parsers (leave blank to disable) =====
# Tool-call parser. Enables OpenAI-style structured tool_calls in responses.
# Auto-tool-choice is enabled automatically when this is set.
#   hermes        -> Qwen2.5 / Qwen3 (Hermes-style tool calls)
#   mistral       -> Mistral
#   llama3_json   -> Llama 3.x JSON tool calls
#   pythonic      -> generic python-style
#   granite       -> IBM Granite
TOOL_CALL_PARSER=hermes

# Separates <think>...</think> reasoning into `reasoning_content`.
#   qwen3         -> Qwen3 family
#   deepseek_r1   -> DeepSeek-R1
REASONING_PARSER=qwen3

# ===== Extra args (appended to the vllm serve command) =====
# Useful flags:
#   --enforce-eager           Disable CUDA graph capture (workaround for WSL / driver issues)
#   --swap-space 4            GiB of CPU swap for KV cache when GPU mem is tight
#   --kv-cache-dtype fp8      Halve KV cache memory (requires Ampere+ GPU)
#   --disable-log-requests    Quieter logs
VLLM_EXTRA_ARGS=
